# ==========================================
# 环境变量配置模板
# ==========================================
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 排除，不会入库。
#   Windows 命令：copy .env.example .env
#   Linux/Mac 命令：cp .env.example .env
#
# ⚠️ 安全提醒：.env 里的密钥不要截图、不要发到聊天群、不要提交到 Git。
#    比赛结束后建议轮换 NVD / GitHub / DeepSeek 三个 key。
# ==========================================


# ---------- 一、依赖漏洞数据源（可选，不填则跳过对应源）----------

# NVD 官方漏洞库 API key
# 申请地址：https://nvd.nist.gov/developers/request-an-api-key
# 不填会走匿名接口，但速率限制为 5 次/分钟，扫描会明显变慢。
NVD_API_KEY=

# GitHub Personal Access Token（查询 GitHub Advisory 数据库，防限流）
# 申请地址：https://github.com/settings/tokens
# 查公开数据无需勾选任何权限，但必须登录才能拿到 token。
GITHUB_TOKEN=

# GitHub 证书校验开关
# 设 False 的场景：电脑开着 Steam++ / Watt Toolkit 加速器，它用自自签证书
# 在本机转发 api.github.com 流量，Python 不认它的证书会报 SSL 错误。
# 不开加速器能直连 GitHub 时，改回 True 更安全。
GITHUB_VERIFY_SSL=True


# ---------- 二、AI 研判层（可选，不填则降级为本地模板）----------

# 方案 A：华为云 MaaS（★赛题要求走这条，优先使用）
#
# 如何获取三个值：
#   1. 打开华为云 MaaS 平台 https://console.huaweicloud.com/maas/
#   2. 完成实名认证 + 学生认证
#   3. 在「开通服务」中申请体验额度（部分模型免费试用）
#   4. 进入「API 调用」/「调用示例」页，页面会直接给出
#      Base URL、API Key、模型名三项，照抄即可
#
# 说明：华为云 MaaS 提供 OpenAI 兼容接口，因此三项都是直填，
#      不需要改代码（modules/adjudicator.py 已按OpenAI 协议实现）。
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=
# 单次调用超时（秒）。深度思考类模型建议 60 以上。
MAAS_TIMEOUT=60

# 方案 B：DeepSeek（国内直连、便宜，适合日常开发和答辩本地演示）
# 注意：这是你自己付费的 key，赛题材料中不要出现它；
#      正式提交前把 MAAS_* 填好，本项留空即可。
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# deepseek-v4-flash 便宜快速 / deepseek-v4-pro 更强更贵
DEEPSEEK_MODEL=deepseek-v4-flash


# ---------- 三、华为云数据库与缓存（赛题②③要求，联调时填）----------

# 赛题原文：「基于已有智能体和 Skills，进行关联 RDS、REDIS 等华为云服务的
#            快速开通创建」
#
# 在哪填：
#   · RDS  → 华为云控制台 → 云数据库 RDS → 实例列表 → 连接信息
#             首次连接需在「安全组」放行你本机 IP 的 3306 端口
#   · Redis→ 华为云控制台 → 分布式缓存 DCS → Redis → 实例 → 连接信息
#             放行 6379 端口
#
# 未配置时：modules/store.py 自动使用 LocalStore（本地 JSON 文件），
#           所有功能可正常运行，仅不落云端。这是设计好的降级，不是故障。

# RDS（关系型数据库，存扫描记录 scan_record / 资产节点与边）
RDS_HOST=
RDS_PORT=3306
RDS_USER=
RDS_PASSWORD=
RDS_DATABASE=agent_security
# 建议创建时选小规格（1核2G / general-1xlarge）省成本

# Redis（缓存与任务队列：扫描结果缓存 + 并发任务队列）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 用途说明（写文档时用得上）：
#   1) 缓存四源漏洞查询结果，避免重复请求同一 CVE（首轮四源查询实测约1035秒）
#   2) 作为并发扫描任务的队列，减少四源查询串行等待


# ---------- 四、部署相关（部署到华为云时填）----------

# 云部署地址（ECS / 容器化部署后填写，用于报告中说明云端环境）
CLOUD_DEPLOY_REGION=cn-north-4
CLOUD_DEPLOY_URL=